{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Node-only SDK: no DOM lib — fetch/Response/Headers types come from
    // @types/node, and accidental browser-global usage fails to compile.
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    // No baseUrl: `paths` resolves relative to this file since TS 4.1, and
    // baseUrl is deprecated in TS 6 (TS5101) and removed in TS 7 (TS5102).
    "paths": {
      "@entrybit/sdk": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "bench",
    "scripts",
    "tsup.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
