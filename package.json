{
  "name": "@entrybit/sdk",
  "version": "0.2.1",
  "description": "Official TypeScript SDK for the EntryBit API — guest passes, member directory, facilities, and OAuth.",
  "license": "MIT",
  "author": "EntryBit",
  "homepage": "https://docs.entrybit.net/resources/sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entrybit-hq/entrybit-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/entrybit-hq/entrybit-sdk-js/issues"
  },
  "keywords": [
    "entrybit",
    "sdk",
    "api",
    "access-control",
    "guest-pass",
    "oauth",
    "oidc",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint && attw --pack .",
    "spec:fetch": "node scripts/fetch-spec.mjs",
    "generate": "openapi-typescript spec/openapi.json -o src/generated/schema.d.ts --default-non-nullable=false",
    "regenerate": "npm run spec:fetch && npm run generate",
    "pack:verify": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:exports && npm run pack:verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
